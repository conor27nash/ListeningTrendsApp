# Spotify OAuth Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:5000/api/login/callback
SPOTIFY_SCOPES=user-top-read user-read-recently-played user-read-private user-read-email user-follow-read user-library-read user-library-modify

# JWT Configuration
JWT_KEY=your_jwt_secret_key_here_minimum_32_characters
JWT_ISSUER=SpotifyTrendsApp
JWT_AUDIENCE=SpotifyTrendsAppClients
JWT_EXPIRES_IN_MINUTES=60

# Client App
CLIENT_APP_BASE_URL=http://localhost:5173

# Service URLs (for local development)
TOPITEMS_SERVICE_URL=http://localhost:5001
RECENTLYPLAYED_SERVICE_URL=http://localhost:5002
TRACK_SERVICE_URL=http://localhost:5003
ARTIST_SERVICE_URL=http://localhost:5004
USER_SERVICE_URL=http://localhost:5005
ANALYTICS_SERVICE_URL=http://localhost:5006

# Logging
LOG_LEVEL=info
